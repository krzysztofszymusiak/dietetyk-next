# Skopiuj do .env.local i uzupełnij (NIGDY nie wrzucaj .env.local do gita)
# Klucze z panelu Paynow (środowisko testowe): Ustawienia > Sklepy i punkty płatności > Dane uwierzytelniające
PAYNOW_API_KEY=klucz-dostepu-do-api
PAYNOW_SIGNATURE_KEY=klucz-obliczania-podpisu
PAYNOW_SANDBOX=true
# Publiczny adres strony (Paynow musi móc do niego wysłać powiadomienie)
SITE_URL=https://twoja-domena.pl
